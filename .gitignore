# Fuentes GIS locales que no hacen falta para publicar el sitio
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.shp.xml
*.zip

# Mantener los GeoJSON que consume la web
!*.geojson

# Mantener los shapefiles ZIP publicados para Riobamba
!riobamba-censo-data/shp/
!riobamba-censo-data/shp/*.zip
!riobamba-censo-data/shp/manifest.json

# Cache local de red peatonal para recalculo de isocronas
riobamba-censo-data/riobamba_osm_walk_network_*.json

# Credenciales y artefactos locales de sincronizacion eGOB
.env.egobedoc.local
outputs/passig_citizen.html
outputs/passig_citizen-meta.json
